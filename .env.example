# Токен Telegram бота (получить у @BotFather)
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Список Telegram ID администраторов через запятую
ADMIN_IDS=123456789,987654321

# Строка подключения к PostgreSQL
DATABASE_URL=postgres://user:password@localhost:5432/zapisbot?sslmode=disable

# Название бота
BOT_NAME=Pulver Farbe

# Начало рабочего дня (час)
WORK_HOUR_START=9

# Конец рабочего дня (час)
WORK_HOUR_END=18

# Временные слоты через запятую (часы)
TIME_SLOTS=9,10,11,14,15,16,17,18

# Включить уведомления (true/false)
NOTIFICATION_ENABLED=true

# Базовые цены по типам изделий (формат: тип:цена,тип:цена)
BASE_PRICES=диски:1500,детали авто:2000,мото-рамы:2500,суппорты:1800,металлоконструкции:5000

# Надбавка за покрытие
COATING_MATTE_SURCHARGE=0
COATING_GLOSSY_SURCHARGE=0

# Надбавка за радиус диска (R13-R24)
RADIUS_13_SURCHARGE=0
RADIUS_14_SURCHARGE=0
RADIUS_15_SURCHARGE=0
RADIUS_16_SURCHARGE=0
RADIUS_17_SURCHARGE=0
RADIUS_18_SURCHARGE=0
RADIUS_19_SURCHARGE=0
RADIUS_20_SURCHARGE=0
RADIUS_21_SURCHARGE=0
RADIUS_22_SURCHARGE=0
RADIUS_23_SURCHARGE=0
RADIUS_24_SURCHARGE=0